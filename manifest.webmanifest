{
"name": "Trace a Circuit",
"short_name": "Trace Circuit",
"description": "Análisis de redes de fibra y localización de cortes desde archivos PDF, KML y KMZ.",
"lang": "es",
"start_url": "./?source=pwa",
"scope": "./",
"display": "standalone",
"orientation": "portrait",
"theme_color": "#123b52",
"background_color": "#f1f5f6",
"prefer_related_applications": false,
"icons": [
{
"src": "./icon-192.png",
"sizes": "192x192",
"type": "image/png",
"purpose": "any maskable"
},
{
"src": "./icon-512.png",
"sizes": "512x512",
"type": "image/png",
"purpose": "any maskable"
}
],
"share_target": {
"action": "./share-target.html",
"method": "POST",
"enctype": "multipart/form-data",
"params": {
"files": [
{
"name": "file",
"accept": [
"application/pdf",
"application/vnd.google-earth.kml+xml",
"application/vnd.google-earth.kmz",
".pdf",
".kml",
".kmz"
]
}
]
}
},
"file_handlers": [
{
"action": "./",
"accept": {
"application/pdf": [".pdf"],
"application/vnd.google-earth.kml+xml": [".kml"],
"application/vnd.google-earth.kmz": [".kmz"]
}
}
]
}
