{
"name": "Piloto CTO",
"short_name": "Piloto CTO",
"description": "Recepción y análisis de archivos PDF, KML y KMZ desde WhatsApp.",
"lang": "es",
"start_url": "./?source=pwa",
"scope": "./",
"display": "standalone",
"orientation": "portrait",
"theme_color": "#155eef",
"background_color": "#f4f6fa",
"prefer_related_applications": false,
"icons": [
{
"src": "./icon-192.png",
"sizes": "192x192",
"type": "image/png",
"purpose": "any maskable"
},
{
"src": "./icon-512.png",
"sizes": "512x512",
"type": "image/png",
"purpose": "any maskable"
}
],
"share_target": {
"action": "./share-target",
"method": "POST",
"enctype": "multipart/form-data",
"params": {
"title": "title",
"text": "text",
"url": "url",
"files": [
{
"name": "file",
"accept": [
"application/pdf",
"application/vnd.google-earth.kml+xml",
"application/vnd.google-earth.kmz",
".pdf",
".kml",
".kmz"
]
}
]
}
},
"file_handlers": [
{
"action": "./",
"accept": {
"application/pdf": [".pdf"],
"application/vnd.google-earth.kml+xml": [".kml"],
"application/vnd.google-earth.kmz": [".kmz"]
}
}
]
}
